# 백엔드 로컬 실행 설정 예시. backend/.env로 복사해 실제 값으로 바꾼다(backend/.env는 git에 올리지 않는다).
# 설명: docs/handbook/source/01-로컬-실행-가이드.md '기존 MySQL을 연결하는 방법'

# 서버 포트. 8080을 다른 프로그램이 쓰고 있으면 바꾸고, frontend/.env.local의 DEV_API_TARGET도 같은 포트로 맞춘다.
SERVER_PORT=8080

# 데이터베이스(MySQL). DB_SCHEMA는 DB_URL의 DB 이름과 같아야 한다.
DB_URL=jdbc:mysql://localhost:3307/timeflow?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_SCHEMA=timeflow
DB_USERNAME=timeflow
DB_PASSWORD=replace-with-local-secret

# JWT 서명 키. UTF-8 32바이트 이상의 무작위 값으로 바꾼다. 운영 키를 넣지 않는다.
JWT_SECRET=use-a-random-32-byte-minimum-secret

# 브라우저가 API를 부르는 출처(쉼표로 구분). 로컬 개발 주소(localhost·127.0.0.1의 5173)는 기본값에 들어 있다.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

# 채팅. 이 프로젝트 Redis(infra/chat/compose.yml, 127.0.0.1:16389)를 켰을 때만 true로 바꾼다.
CHAT_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=16389
