# 프런트엔드 개발 설정 예시. frontend/.env.local로 복사해 값을 바꾼다(.env.local은 git에 올리지 않는다).
# VITE_로 시작하는 값은 빌드된 웹에 공개되므로 비밀값을 넣지 않는다.

# 개발 서버(npm run dev)가 /api 요청을 넘길 백엔드 주소. backend/.env의 SERVER_PORT와 같은 포트로 맞춘다.
DEV_API_TARGET=http://127.0.0.1:8080

# 브라우저가 API를 직접 부를 주소. 비워 두면 위 개발 프록시나 같은 출처 배포를 쓴다.
# GitLab Pages 빌드는 .env.pages.example과 npm run build:pages를 본다.
VITE_API_BASE_URL=
